# Read this file explicitly in your shell, or copy to .env for Docker Compose.
# Never put account passwords or access tokens here.
DOGSHARE_ACCOUNT_DB=data/accounts.sqlite3
DOGSHARE_ACCOUNT_HOST=127.0.0.1
DOGSHARE_ACCOUNT_PORT=8091
# Set a different host port when retaining the original account service.
DOGSHARE_ACCOUNT_PUBLISH_PORT=8092
DOGSHARE_SESSION_TTL_SECONDS=43200
DOGSHARE_REMEMBER_TTL_SECONDS=604800
DOGSHARE_TICKET_TTL_SECONDS=300
DOGSHARE_LOGIN_WINDOW_SECONDS=60
DOGSHARE_LOGIN_IP_LIMIT=30
DOGSHARE_LOGIN_ACCOUNT_LIMIT=10
DOGSHARE_HASH_CONCURRENCY=2
DOGSHARE_PUBLIC_DOCS=0
# Empty leaves the web administrator routes disabled.
DOGSHARE_ADMIN_ORIGIN=
DOGSHARE_ADMIN_PATH=/admin
DOGSHARE_ADMIN_SESSION_TTL_SECONDS=3600
# Only explicit proxy IP addresses; no wildcard or network range.
DOGSHARE_TRUSTED_PROXY_IPS=
