# Read this file explicitly in your shell, or copy to .env for Docker Compose.
# Never put account passwords or access tokens here.
TOMDESK_ACCOUNT_DB=data/accounts.sqlite3
TOMDESK_ACCOUNT_HOST=127.0.0.1
TOMDESK_ACCOUNT_PORT=8091
# Set a different host port when retaining the original account service.
TOMDESK_ACCOUNT_PUBLISH_PORT=8092
TOMDESK_SESSION_TTL_SECONDS=43200
TOMDESK_REMEMBER_TTL_SECONDS=604800
TOMDESK_TICKET_TTL_SECONDS=300
TOMDESK_LOGIN_WINDOW_SECONDS=60
TOMDESK_LOGIN_IP_LIMIT=30
TOMDESK_LOGIN_ACCOUNT_LIMIT=10
TOMDESK_HASH_CONCURRENCY=2
TOMDESK_PUBLIC_DOCS=0
# Empty leaves the web administrator routes disabled.
TOMDESK_ADMIN_ORIGIN=
TOMDESK_ADMIN_PATH=/admin
TOMDESK_ADMIN_SESSION_TTL_SECONDS=3600
# Only explicit proxy IP addresses; no wildcard or network range.
TOMDESK_TRUSTED_PROXY_IPS=
